# Template for slack-mcp-server.env (pass it with --env-file; keep it mode 0600).
# Only SLACK_MCP_* settings are allowed, and this file is the only source of
# them: inherited SLACK_MCP_* environment variables are ignored.

# User OAuth Token (starts with xoxp-)
SLACK_MCP_XOXP_TOKEN="" # Replace with your user OAuth token

# Bot OAuth Token (starts with xoxb-)
SLACK_MCP_XOXB_TOKEN="" # Replace with your bot token

# SSE/HTTP transports only. The server listens on 127.0.0.1 by default; any
# non-loopback bind (e.g. 0.0.0.0) requires an API key.
# SLACK_MCP_HOST="0.0.0.0"
# SLACK_MCP_PORT="13080"
# SLACK_MCP_API_KEY="" # Bearer token clients must send
